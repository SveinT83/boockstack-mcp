{
  "name": "td-bookstack-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "rotate-keys": "tsx src/rotate.ts",
    "check-upstream": "tsx scripts/check-upstream.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:runtime": "tsx scripts/smoke-runtime.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "13.1.1",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "openid-client": "6.8.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "description": "Standalone BookStack MCP server with Keycloak OAuth and encrypted per-user API tokens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SveinT83/boockstack-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SveinT83/boockstack-mcp/issues"
  }
}
